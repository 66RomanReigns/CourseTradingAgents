# Recommended setup:
#   make secrets-configure
# This writes a chmod-600 file outside Git at:
#   ~/.config/tradinglab/tradinglab.keys
# Never commit real keys.

# Selected remote research provider. The default execution mode is dry_run,
# so this is not read until workflow mode and LLM execution are explicitly live.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash

# Local operator token for every non-public FastAPI endpoint.
# Generate it with scripts/ensure_api_token.py; never expose it in URLs.
TRADINGLAB_API_TOKEN=

# Legacy compatible provider retained for optional experiments.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
GOOGLE_API_KEY=

# The AQ-prefixed Google key is treated as a likely Gemini authorization key.
# Gemini remains disabled until a dedicated client is enabled and quotas are verified.
GEMINI_MODEL=gemini-2.5-flash-lite

# SEC requires an identifying User-Agent with a real contact address.
# Example: TradeLab-Agent your_email@example.com
SEC_USER_AGENT=
